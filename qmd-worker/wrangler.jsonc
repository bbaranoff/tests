{
  "name": "qmd-dossier",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // npx wrangler deploy régénère d'abord le dossier (dernier banc seulement)
  "build": { "command": "node build.mjs" },
  "routes": [
    { "pattern": "tests.pl4y.store", "custom_domain": true },
    // plus précise que la route *.pl4y.store/* du worker pl4y, qui sinon passe devant
    { "pattern": "tests.pl4y.store/*", "zone_name": "pl4y.store" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
